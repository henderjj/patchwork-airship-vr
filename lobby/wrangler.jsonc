{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "patchwork-lobby",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "Lobby", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://henderjj.github.io"
  }
}
